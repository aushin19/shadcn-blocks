{
  "name": "shadcn-blocks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run registry:build",
    "dev": "next dev",
    "prebuild": "npm run registry:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check:registry-structure": "node scripts/check-registry-structure.mjs",
    "test:registry": "node --test tests/registry-structure.test.mjs",
    "ci:local": "npm run check:registry-structure && npm run test:registry && npm run registry:validate && npm run lint && npm run typecheck && npm run build",
    "registry:build": "shadcn registry validate && shadcn build",
    "registry:validate": "shadcn registry validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
