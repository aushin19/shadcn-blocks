{
  "name": "shadcn-blocks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run registry:build",
    "dev": "node scripts/dev-with-showcase.mjs",
    "prebuild": "npm run registry:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && node scripts/check-raw-component-styles.mjs && node scripts/check-design-system-css.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check:registry-structure": "node scripts/check-registry-structure.mjs",
    "check:registry-dependencies": "node scripts/check-registry-dependencies.mjs",
    "check:raw-component-styles": "node scripts/check-raw-component-styles.mjs",
    "check:design-system-css": "node scripts/check-design-system-css.mjs",
    "test:registry": "node --test tests/registry-structure.test.mjs tests/registry-dependencies.test.mjs",
    "test:design-system": "node --test tests/design-system-css.test.mjs tests/local-token-aliases.test.mjs tests/raw-component-rules.test.mjs",
    "ci:local": "npm run check:registry-structure && npm run check:registry-dependencies && npm run test:registry && npm run test:design-system && npm run check:design-system-css && npm run registry:validate && npm run lint && npm run typecheck && npm run build",
    "registry:build": "node scripts/generate-showcase-manifest.mjs && shadcn registry validate && shadcn build",
    "registry:validate": "shadcn registry validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.15.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
